      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "avg(sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}) / on (pod) group_left() sum by (pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"memory\"}))",
          "refId": "A"
        }
      ],
      "title": "Memory vs Limit (avg)",
