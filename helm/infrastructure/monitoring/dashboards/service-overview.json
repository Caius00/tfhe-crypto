      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(axum_http_requests_total{namespace=~\"$namespace\", pod=~\"$pod\", status=~\"5..\"}[$__rate_interval])) / sum(rate(axum_http_requests_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "5xx rate",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(rate(axum_http_requests_total{namespace=~\"$namespace\", pod=~\"$pod\", status=~\"4..\"}[$__rate_interval])) / sum(rate(axum_http_requests_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "4xx rate",
          "refId": "B"
        }
      ],
      "title": "Error Rate (4xx / 5xx Anteil)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Top 10 Endpunkte nach p95-Latenz.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
